{
  "name": "read-podcast-edge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "check:frontend": "node --check public/app.js && python3 scripts/build_frontend.py --check",
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "setup": "node scripts/setup.mjs",
    "build:server": "node scripts/build_server.mjs",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.7"
  }
}
