# 随 App 分发的 ffmpeg / ffprobe 固定官方源码。
#
# 为什么内嵌：普通用户不该为了用这个 App 先装 Homebrew。ffmpeg 缺失曾经是
# 干净 Mac 上的首个硬失败点。
#
# 必须是 LGPL 构建（configure 不带 --enable-gpl）。本项目是 MIT，通过 subprocess
# 调用独立可执行文件，随包分发 LGPL 构建不影响主体许可；GPL 构建会把整个发布
# 拖进 GPL。填入前请自行确认所选构建的许可证与架构（arm64）。
#
# 打包脚本用 --disable-autodetect 且不启用 GPL/nonfree，从官方源码现场构建。
# 换版本时三个值必须一起更新。
#
# 校验哈希：shasum -a 256 下载到的归档
READ_PODCAST_FFMPEG_VERSION="7.1.5"
READ_PODCAST_FFMPEG_URL="https://ffmpeg.org/releases/ffmpeg-7.1.5.tar.xz"
READ_PODCAST_FFMPEG_SHA256="de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f"
