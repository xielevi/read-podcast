{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "read-podcast-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  // 只经 custom domain 暴露：Cloudflare Access 在该域名上按路径保护 /manage* 与 /api/control/*，
  // workers.dev / preview URL 不受 Access 保护，必须保持关闭（见 docs/DEPLOYMENT.md）。
  // 本仓库不写任何部署者自己的值：custom domain 与下方 vars 中的部署值由 scripts/deploy.mjs
  // （npm run deploy:production）在部署时以 --domain / --var 注入；社区 npm run deploy 见 scripts/deploy_community.mjs。
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/manage*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // 刻意不写 database_id：wrangler 按 database_name 关联同名数据库（部署时沿用已绑定的库，
      // 不存在时自动创建；d1 migrations 等命令也按名字查找）。
      "database_name": "read-podcast-edge",
      "migrations_dir": "migrations"
    }
  ],
  // 原始转录与自定义上传音频的临时 checkpoint（retry 复用 / 故障恢复）。
  // binding 不会自动创建生命周期规则；部署时必须单独配置并验证（见 docs/DEPLOYMENT.md）：
  //   npx wrangler r2 bucket lifecycle add read-podcast-edge-raw raw-7d raw/ --expire-days 7
  //   npx wrangler r2 bucket lifecycle add read-podcast-edge-raw refined-7d refined/ --expire-days 7
  //   npx wrangler r2 bucket lifecycle add read-podcast-edge-raw uploads-1d uploads/ --expire-days 1 --abort-multipart-days 1
  //   npx wrangler r2 bucket lifecycle list read-podcast-edge-raw
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "read-podcast-edge-raw"
    }
  ],
  // Processing Workflow：任务从创建到成稿的 durable 编排（转录 → raw 落 R2 → 精修 → 质量门禁 → 成稿 → GitHub 入库）。
  // 转录只是它调用的外部计算（Transcription Service）。instance retention 在创建时收紧
  // （success 1 day / error 3 days），见 src/workflows/processing.ts。
  //
  // 升级注意：workflow name 与旧的 RefineWorkflow 不同（read-podcast-refine → read-podcast-processing）。
  // 迁移 0015 会把升级瞬间仍活跃的任务重新排队，由新 Workflow 接手（raw 已在 R2 的不重新转录）。
  "workflows": [
    {
      "name": "read-podcast-processing",
      "binding": "PROCESSING_WORKFLOW",
      "class_name": "ProcessingWorkflow"
    }
  ],
  // Cloudflare 自有的收敛动作：未启动 Workflow 的 queued 任务 / Workflow 存活对账。
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_ENV": "production",
    // 转录服务 endpoint：部署时由 READ_PODCAST_TRANSCRIPTION_URL 注入；本地开发在 .dev.vars 中设置。
    "TRANSCRIPTION_SERVICE_URL": "",
    // 转录实现：self-hosted（默认，自托管 Transcription Service）| dashscope（百炼 Paraformer）。
    // 部署时由 READ_PODCAST_TRANSCRIPTION_PROVIDER 注入；dashscope 需另注入 secret DASHSCOPE_API_KEY。
    "TRANSCRIPTION_PROVIDER": "self-hosted",
    // 自定义上传音频的 presigned GET 目标桶（与上面 r2_buckets[].bucket_name 同一个值，不是机密）。
    "R2_BUCKET_NAME": "read-podcast-edge-raw",
    // ── 必须单独注入的 secret（刻意不写进仓库）──
    //   CONTROL_AUTH_USER            Basic Auth 用户名（保护 /manage* 与 /api/control/*，workers.dev 必需）
    //   CONTROL_AUTH_PASSWORD        Basic Auth 密码（同上）
    //   CF_ACCESS_CLIENT_ID          Cloudflare Access service token（转录服务入口）
    //   CF_ACCESS_CLIENT_SECRET      ── 同上
    //   R2_ACCOUNT_ID                签发 presigned GET 用的最小权限 R2 凭据（account id）
    //   R2_ACCESS_KEY_ID             ── 同上（access key id）
    //   R2_SECRET_ACCESS_KEY         ── 同上（secret access key）
    //   GITHUB_TOKEN / REFINER_API_KEY
    // 注入方式见 docs/DEPLOYMENT.md：npx wrangler secret put <NAME>
    // Canonical Manuscript Store：部署时由 READ_PODCAST_GITHUB_* 注入（branch / path 可选）。
    "GITHUB_OWNER": "",
    "GITHUB_REPO": "",
    "GITHUB_BRANCH": "main",
    "GITHUB_PODCAST_PATH": "podcasts/transcripts"
  }
}
