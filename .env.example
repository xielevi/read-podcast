# Read Podcast 本地 Docker / Node.js 运行环境变量配置示例
# 复制本文件为 .env：cp .env.example .env

# LLM 精修服务密钥（OpenAI 兼容接口，必填）
REFINER_API_KEY=your-refiner-api-key

# 稿件存储（Canonical Manuscript Store）。MANUSCRIPT_STORE=github|notion-r2|local。
# Docker 默认 local（compose 注入 MANUSCRIPT_PATH=/data/manuscripts）。
#
# MANUSCRIPT_PATH=./manuscripts
# MANUSCRIPT_STORE=local
#
#   GitHub（显式选择，或未设 MANUSCRIPT_PATH 时的 Docker 回落）：
# GITHUB_TOKEN=your-github-fine-grained-token
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=your-manuscript-repository
# GITHUB_BRANCH=main
# GITHUB_PODCAST_PATH=podcasts/transcripts
#
#   Notion + 本地对象存储快照（可选）：
# MANUSCRIPT_STORE=notion-r2
# NOTION_TOKEN=secret_xxx
# NOTION_PODCAST_DATA_SOURCE_ID=your-notion-data-source-id
# NOTION_SCHEMA=en
MANUSCRIPT_TIME_ZONE=Asia/Shanghai

# 转录提供方：self-hosted（默认，Docker compose 内的转录容器）或 dashscope（百炼 Paraformer）
TRANSCRIPTION_PROVIDER=self-hosted
# TRANSCRIPTION_SERVICE_URL=http://transcription:28100
# TRANSCRIPTION_LANGUAGE=zh
# DASHSCOPE_API_KEY=your-dashscope-api-key

# 可选：控制面 Basic Auth（保护 /manage* 与 /api/control/*；不设则无密码）
# CONTROL_AUTH_USER=admin
# CONTROL_AUTH_PASSWORD=your-secure-password

# 可选：本地对象存储临时下载签名密钥。
# 若留空，服务启动时将自动生成 32 字节高强度随机密钥并持久化至 /data/signing.key (0600 权限)，绝不使用默认硬编码密钥。
# INTERNAL_SIGNING_SECRET=your-random-secret-key
