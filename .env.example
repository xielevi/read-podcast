# Read Podcast 密钥文件。请复制为 .env 后填写。
# 这里只放“密钥”，普通设置在 config.default.yaml / config/config.yaml。
#
# 也可以留空不填：启动后在网页右上角「设置」里填，会保存到 config/secrets.env（权限 0600）。
# 优先级：这里（或 Compose 注入）的非空值 > config/secrets.env；被环境变量接管的字段在网页上只读。

# 【必填】AI 精修服务的 Key，用来把语音转录稿整理成漂亮的文章。
# 新手可选免费的 OpenCode Zen（注册即用免充值），也可用便宜的 DeepSeek 等。
# 申请步骤、以及要一起修改的 config 里 refiner.api_base / model，见 README「申请 AI Key」。
REFINER_API_KEY=

# 【选填】给语音转录后端加一道访问口令（mlx-api 后端使用）。
# 一键原生模式可留空；Docker 或跨设备访问时必须填一串长随机字符串。
READ_PODCAST_WHISPER_API_TOKEN=

# 【选填】外部跨平台转录 API 的 Key。
# 用于调用 OpenAI 兼容的 /audio/transcriptions 服务（Groq、OpenAI、自建服务等）。
# 仅用 Apple 芯片本机 MLX 或内置 Faster-Whisper Compose 模式时可留空。
READ_PODCAST_TRANSCRIPTION_API_KEY=

# 【选填】内置 Faster-Whisper 与 Web 应用之间的内部口令。
# 转录服务默认不映射宿主端口；若填写，Compose 两端会同时使用。
READ_PODCAST_BUILTIN_TRANSCRIPTION_TOKEN=

# 【选填】给网页界面加登录用户名和密码（两者要同时填）。
# 公网访问时建议开启；本机自用可留空。
READ_PODCAST_BASIC_AUTH_USERNAME=
READ_PODCAST_BASIC_AUTH_PASSWORD=

# 【选填】文件连接器凭据（均属机密）。名字要和 config 里 connectors[].*_env 对应；
# 不用连接器可全部留空。
# —— 群机器人 Webhook 地址（飞书/钉钉群机器人，或自建服务/Zapier 接收地址）——
READ_PODCAST_CONNECTOR_FEISHU_URL=
READ_PODCAST_CONNECTOR_DINGTALK_URL=
READ_PODCAST_CONNECTOR_WEBHOOK_URL=
# —— 云文档知识库凭据 ——
# Notion：集成 token（secret_ 开头），并在 config 里填 database_id 或 page_id。
READ_PODCAST_CONNECTOR_NOTION_TOKEN=
# 飞书文档：自建应用的 App ID / App Secret（需开通 docx 文档权限）。
READ_PODCAST_CONNECTOR_FEISHU_APP_ID=
READ_PODCAST_CONNECTOR_FEISHU_APP_SECRET=
# Google Drive：OAuth 客户端（桌面应用类型）与一次性换来的刷新令牌。
# 需要 https://www.googleapis.com/auth/drive.file 作用域；获取步骤见 README。
READ_PODCAST_CONNECTOR_GDRIVE_CLIENT_ID=
READ_PODCAST_CONNECTOR_GDRIVE_CLIENT_SECRET=
READ_PODCAST_CONNECTOR_GDRIVE_REFRESH_TOKEN=
